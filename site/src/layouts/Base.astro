---
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_NAME, SITE_URL, TIFFIN_ANALYTICS, UMAMI, abs } from "../config/site";
import { breadcrumbs, graph, organization, website } from "../lib/jsonld";

interface Props {
  title: string;
  description: string;
  /** OG image slug under /og/, e.g. "home" → /og/home.png */
  og?: string;
  /** Breadcrumb trail after Home, e.g. [{ name: "Docs", path: "/docs/" }] */
  crumbs?: { name: string; path: string }[];
  /** Extra JSON-LD nodes for this page. */
  schema?: object[];
  noindex?: boolean;
  type?: "website" | "article";
  /** Append " · Reelbird" to the title (skipped when the title already names it). */
  brand?: boolean;
}
const { title, description, og = "home", crumbs = [], schema = [], noindex = false, type = "website", brand = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = abs(`/og/${og}.png`);
const fullTitle = !brand || title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`;
const nodes = [organization(), website(), ...schema];
if (crumbs.length) nodes.push(breadcrumbs([{ name: "Home", path: "/" }, ...crumbs]));
const ld = JSON.stringify(graph(...nodes)).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFF4E8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1A1512" />
    <script is:inline>(()=>{const d=document.documentElement;d.classList.add("js");try{const t=localStorage.getItem("theme");if(t==="light"||t==="dark")d.dataset.theme=t}catch(e){}})()</script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Reelbird changelog" href="/changelog/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ld} />
    {UMAMI.websiteId && <script is:inline defer src={UMAMI.script} data-website-id={UMAMI.websiteId} data-domains={new URL(SITE_URL).hostname} data-exclude-search="true"></script>}
    {TIFFIN_ANALYTICS.script && (
      <script is:inline define:vars={{ tiffinScript: TIFFIN_ANALYTICS.script, siteHost: new URL(SITE_URL).hostname }}>
        // Tiffin's script on the site's own host only (like Umami's data-domains). Every data-umami-event click
        // also goes to tiffin.track() under the same name; calls made before the script loads wait in tiffin.q.
        if (location.hostname === siteHost) {
          window.tiffin = window.tiffin || { q: [], track: function () { this.q.push(arguments); } };
          const s = document.createElement("script");
          s.src = tiffinScript;
          document.head.append(s);
          document.addEventListener("click", (e) => {
            const el = e.target instanceof Element ? e.target.closest("[data-umami-event]") : null;
            if (!el) return;
            const props = {};
            for (const a of el.attributes) if (a.name.startsWith("data-umami-event-")) props[a.name.slice(17)] = a.value;
            window.tiffin.track(el.getAttribute("data-umami-event"), Object.keys(props).length ? props : undefined);
          }, true);
        }
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal sections as they scroll in. CSS keeps everything visible without JS or with reduced motion.
      const els = document.querySelectorAll("[data-reveal]");
      if (els.length && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add("is-in"));

      // A table that scrolls sideways (phones) must be reachable by keyboard: make the scroller a
      // focusable, named region only while it actually overflows.
      // Markdown tables have no wrapper, so give them one (CSS keeps them scrollable without JS).
      document.querySelectorAll<HTMLTableElement>(".prose table").forEach((t) => {
        if (t.parentElement?.classList.contains("table-wrap")) return;
        const w = document.createElement("div");
        w.className = "table-wrap";
        t.before(w); w.append(t);
      });
      const scrollers = document.querySelectorAll<HTMLElement>(".table-wrap");
      const mark = (el: HTMLElement) => {
        const scrolls = el.scrollWidth > el.clientWidth + 1;
        if (scrolls && !el.hasAttribute("tabindex")) {
          el.tabIndex = 0;
          el.setAttribute("role", "region");
          const cap = el.querySelector("caption")?.textContent?.trim();
          el.setAttribute("aria-label", cap ? `${cap} (scrolls sideways)` : "Table (scrolls sideways)");
        } else if (!scrolls && el.getAttribute("tabindex") === "0") {
          el.removeAttribute("tabindex"); el.removeAttribute("role"); el.removeAttribute("aria-label");
        }
      };
      if (scrollers.length) {
        if ("ResizeObserver" in window) { const ro = new ResizeObserver((es) => es.forEach((e) => mark(e.target as HTMLElement))); scrollers.forEach((el) => ro.observe(el)); }
        else scrollers.forEach(mark);
      }
    </script>
  </body>
</html>
