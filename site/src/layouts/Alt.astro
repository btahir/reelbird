---
// "X alternative" pages, answer first: H1 with the keyword, a self-contained answer paragraph,
// a dated fact table, who should pick which, a short clip, an FAQ that names the other app,
// and the install CTA with its caveat. JSON-LD (Article + FAQPage) mirrors the visible text.
import Base from "./Base.astro";
import PageHead from "../components/PageHead.astro";
import ClipLoop from "../components/ClipLoop.astro";
import Faq from "../components/Faq.astro";
import Icon from "../components/Icon.astro";
import type { Faq as FaqItem } from "../data/faq";
import { CHECKED, CHECKED_LABEL, byId } from "../data/compare";
import { GITHUB_URL, RELEASE_DATE } from "../config/site";
import { article, faqPage } from "../lib/jsonld";

interface Props {
  seoTitle: string; description: string; path: string; og: string;
  title: string;
  /** The direct answer: first paragraph, quotable on its own. */
  answer: string;
  /** One-sentence verdict under the table. */
  verdict: string;
  rival: string;
  rows: [string, string, string][];
  better: string[];
  ours: string[];
  faq: FaqItem[];
  /** Optional: other apps searchers weigh against the rival, as a short table. Cells may hold links. */
  others?: { id: string; heading: string; intro: string; columns: string[]; rows: string[][]; caption: string };
}
const { seoTitle, description, path, og, title, answer, verdict, rival, rows, better, ours, faq, others } = Astro.props;
const r = byId(rival);
const crumbs = [{ name: title, path }];
const schema = [
  article({ title, description, path, datePublished: RELEASE_DATE, dateModified: CHECKED }),
  faqPage(faq),
];
---
<Base title={seoTitle} description={description} og={og} crumbs={crumbs} type="article" schema={schema}>
  <PageHead title={title} crumbs={crumbs}>
    <p class="answer">{answer}</p>
    <p class="stamp">Updated <time datetime={CHECKED}>{CHECKED_LABEL}</time>. {r.name} facts from {r.sources.map((s, i) => <>{i > 0 && " and "}<a href={s.href}>{s.label}</a></>)}.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />Get Reelbird — free</a>
      <span class="caveat">Download for Apple silicon, or build from source. macOS 15 or later. Mac only.</span>
    </div>
  </PageHead>

  <section class="wrap block" aria-labelledby="facts">
    <h2 id="facts">Reelbird vs {r.name}, side by side</h2>
    <div class="table-wrap">
      <table class="facts">
        <caption>Prices and features checked {CHECKED_LABEL}. Sources: {r.sources.map((s, i) => <>{i > 0 && ", "}<a href={s.href}>{s.label}</a></>)}.</caption>
        <thead><tr><th scope="col"><span class="sr-only">Fact</span></th><th scope="col">Reelbird</th><th scope="col">{r.name}</th></tr></thead>
        <tbody>
          {rows.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="verdict">{verdict}</p>
  </section>

  <section class="wrap block two" aria-labelledby="pick">
    <h2 id="pick" class="sr-only">Who should pick which</h2>
    <div>
      <h3>Pick {r.name} if</h3>
      <ul class="plain">{better.map((b) => <li set:html={b} />)}</ul>
    </div>
    <div>
      <h3>Pick Reelbird if</h3>
      <ul class="plain">{ours.map((b) => <li set:html={b} />)}</ul>
    </div>
  </section>

  {others && (
    <section class="wrap block" aria-labelledby={others.id}>
      <h2 id={others.id}>{others.heading}</h2>
      <p class="intro" set:html={others.intro} />
      <div class="table-wrap">
        <table class="facts others">
          <caption set:html={others.caption} />
          <thead><tr>{others.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {others.rows.map(([name, ...cells]) => <tr><th scope="row" set:html={name} />{cells.map((c) => <td set:html={c} />)}</tr>)}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="wrap block" aria-labelledby="clip">
    <h2 id="clip">An auto-zoom export, as it comes out</h2>
    <ClipLoop />
  </section>

  <section class="wrap block faq" aria-labelledby="alt-faq">
    <h2 id="alt-faq">{r.name} and Reelbird: questions</h2>
    <Faq items={faq} />
    <p class="more"><a class="link-arrow" href="/compare/">Compare eight Mac screen recorders</a></p>
  </section>

  <section class="wrap block end">
    <h2>Try it on your own screen.</h2>
    <p class="muted">Download it or build it, then record. If it isn't for you, delete the app; nothing else was installed.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/download/"><Icon name="download" />Get Reelbird — free</a>
      <a class="btn btn-ghost" href={GITHUB_URL}><Icon name="github" />Source on GitHub</a>
    </div>
  </section>
</Base>

<style>
  .answer { margin-top: 1.25rem; max-width: 44rem; font-size: var(--step-1); line-height: 1.5; color: var(--text-muted); }
  .stamp { margin-top: 0.9rem; font-size: var(--step--1); color: var(--text-muted); }
  .stamp a { color: inherit; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 2rem; }
  .caveat { font-size: var(--step--1); color: var(--text-muted); max-width: 22rem; }
  .block { padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); border-top: 1px solid var(--line); }
  .block h2 { font-size: var(--step-3); margin-bottom: 1.75rem; }
  .facts { font-size: 0.975rem; min-width: 36rem; }
  .facts caption { caption-side: bottom; text-align: left; padding-top: 1rem; font-size: var(--step--1); color: var(--text-muted); }
  .facts caption a { color: inherit; }
  .facts th[scope="row"] { color: var(--text); font-weight: 600; width: 22%; font-size: 0.95rem; }
  .facts td { width: 39%; color: var(--text-muted); }
  .facts td:first-of-type { color: var(--text); }
  .facts thead th { font-size: 1rem; color: var(--text); }
  .intro { max-width: 44rem; margin-bottom: 1.5rem; color: var(--text-muted); }
  .others { min-width: 44rem; }
  .others th[scope="row"] { width: 16%; }
  .others td { width: auto; }
  .others td:first-of-type { color: var(--text-muted); }
  .verdict { margin-top: 1.75rem; max-width: 44rem; font-size: 1.0625rem; }
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  .two h3 { font-family: var(--font-display); font-weight: 520; font-size: var(--step-2); letter-spacing: -0.01em; margin-bottom: 1.25rem; }
  .plain { padding-left: 1.1rem; display: grid; gap: 0.7rem; color: var(--text-muted); }
  .faq { max-width: 52rem; margin-inline: auto; }
  .more { margin-top: 2rem; }
  .end { text-align: center; display: grid; justify-items: center; gap: 0.5rem; padding-bottom: var(--section); }
  .end h2 { margin-bottom: 0.5rem; }
  .end .cta { justify-content: center; }
  @media (max-width: 48rem) { .two { grid-template-columns: minmax(0, 1fr); } }
</style>
