---
import Alt from "../layouts/Alt.astro";
const faq = [
  { id: "tella-free", q: "Is Tella free?", a: "No. As of 7 November 2026 Tella has no free plan, only a 7-day free trial. Pro is $13 and Premium $19 per user a month, billed yearly. Reelbird is free and MIT licensed; optional Reelbird Pro is $5 a month if you want your links hosted.", html: "No. As of 7 November 2026 Tella has no free plan, only a 7-day free trial. Pro is $13 and Premium $19 per user a month, billed yearly (<a href=\"https://www.tella.com/pricing\">Tella pricing</a>). Reelbird is free and MIT licensed; optional <a href=\"/pricing/\">Reelbird Pro</a> is $5 a month if you want your links hosted." },
  { id: "free-tella", q: "Is there a free Tella alternative for Mac?", a: "Reelbird is one: free, open source and native to the Mac, with auto-zoom, captions, camera layouts and a share link the moment you stop. It doesn't have Tella's browser editor, team workspace or Windows app." },
  { id: "auto-zoom", q: "Do both have auto-zoom?", a: "Yes. Tella lists zoom effects and auto zoom. Reelbird plans zooms from your clicks and typing, with one intensity slider, and every zoom is editable on the timeline." },
  { id: "files", q: "Where do my videos live?", a: "With Tella, in Tella's cloud, and you can download them. With Reelbird, every take is a folder of MP4 files on your Mac from the start; a shared video also goes to your own bucket or to Reelbird Pro." },
  { id: "teams", q: "Is Reelbird good for a team?", a: "It works for anyone who can open a link, but it has no shared workspace, comments or SSO. If your team edits and publishes together, Tella does more." },
];
---
<Alt
