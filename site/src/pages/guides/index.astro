---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
const crumbs = [{ name: "Guides", path: "/guides/" }];
const guides = [
  { href: "/guides/record-mac-screen-with-internal-audio/", title: "Record your Mac screen with internal audio", text: "System audio, microphone and screen together on macOS 15 and later, with no virtual audio driver." },
  { href: "/guides/add-captions-to-screen-recording-mac/", title: "Add captions to a screen recording on Mac", text: "On-device transcription, six caption styles drawn into the video, a captions track on links, and SRT or VTT files." },
  { href: "/guides/screen-recording-to-vertical-video/", title: "Turn a screen recording into a vertical 9:16 video", text: "For Reels, Shorts and TikTok: the 9:16 canvas, zooms, a stacked camera layout and big captions." },
  { href: "/guides/record-screen-with-webcam-mac/", title: "Record your screen with a webcam overlay", text: "A camera bubble you can move and reshape after recording, plus camera-only and side-by-side layouts." },
  { href: "/guides/self-host-screen-recording-links-cloudflare-r2/", title: "Self-host Loom-style share links on Cloudflare R2", text: "A bucket, a public URL and a token: links on your own storage, with no server to run." },
  { href: "/guides/record-specific-window-mac/", title: "Record a specific window on Mac", text: "One window only: the Screenshot toolbar's window option on newer macOS, Reelbird's picker including other desktops, and the command line." },
  { href: "/guides/share-screen-recording-mac/", title: "Share a screen recording from your Mac", text: "Email limits, Mail Drop, AirDrop and links compared, plus a share link the moment you stop recording." },
  { href: "/guides/trim-crop-screen-recording-mac/", title: "Trim, cut and crop a screen recording on Mac", text: "QuickTime for the basics; Reelbird for cuts in the middle, cropping, aspect ratio and speed." },
  { href: "/guides/reduce-screen-recording-file-size-mac/", title: "Make a Mac screen recording smaller", text: "QuickTime's Export As, or HEVC, resolution and frame rate in Reelbird. Or send a link instead of a file." },
  { href: "/guides/screen-recording-to-gif-mac/", title: "Turn a Mac screen recording into a GIF", text: "Size, frame rate and the command line export, and when a short MP4 is the better choice." },
  { href: "/guides/screen-record-mac-without-background-noise/", title: "Screen record on Mac without background noise", text: "Room noise or Mac-only sound: what macOS offers, and how Reelbird cleans up your voice after recording." },
  { href: "/guides/remove-ums-and-pauses-from-screen-recording/", title: "Remove ums and pauses from a screen recording", text: "Clean Up shortens pauses and cuts ums on your Mac, with Review and Undo. And what it misses." },
  { href: "/guides/hide-cursor-screen-recording-mac/", title: "Hide the cursor in a Mac screen recording", text: "Before recording with the Screenshot toolbar, or after recording in Reelbird, where you can also resize and smooth it." },
  { href: "/guides/show-keystrokes-screen-recording-mac/", title: "Show keystrokes in a Mac screen recording", text: "Reelbird's keystroke overlay: permissions, shortcuts or typed text, and turning it on after recording." },
  { href: "/guides/claude-code-screen-recording/", title: "Can Claude Code record the screen?", text: "Yes, with an MCP server. Add Reelbird's and ask for a demo of the change, with a link back." },
  { href: "/features/step-by-step-guides/", title: "Turn a screen recording into a step-by-step guide", text: "Every click becomes a step with a screenshot; share a Click-through or export Markdown." },
];
---
<Base title="Reelbird guides" description="Step-by-step guides for recording your Mac screen with Reelbird, the free, open-source screen recorder." og="guides" crumbs={crumbs}>
  <PageHead title="Guides" lede="Step by step, with the caveats." crumbs={crumbs} />
  <div class="wrap list">
    <ul>{guides.map((g) => <li><a href={g.href}><strong>{g.title}</strong></a><span>{g.text}</span></li>)}</ul>
  </div>
</Base>
<style>
  .list { padding-bottom: var(--section); }
  ul { list-style: none; padding: 0; border-top: 1px solid var(--line); max-width: 46rem; }
  li { display: grid; gap: 0.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  a { text-decoration: none; font-size: 1.125rem; }
  strong { font-weight: 600; }
  span { color: var(--text-muted); }
</style>
