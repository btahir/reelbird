---
import Alt from "../layouts/Alt.astro";
import { CHECKED_LABEL } from "../data/compare";
const faq = [
  { id: "loom-limit", q: "Does Loom's free plan have a time limit?", a: `Yes. As of ${CHECKED_LABEL}, Loom's free Starter plan stops each screen recording at 5 minutes, keeps up to 25 videos per person and records at up to 720p. Reelbird sets no length or video limit; your disk and, for links, your bucket (or Reelbird Pro's 100 GB) are the only limits.` },
  { id: "loom-download", q: "Can I download my videos on Loom's free plan?", a: "No. Atlassian's Loom help says users on the Starter plan can't download videos; downloading needs Business or higher. In Reelbird every take is already a folder of standard MP4 files on your Mac, and you can export MP4 (H.264), HEVC, ProRes or GIF.", html: `No. <a href="https://support.atlassian.com/loom/docs/download-your-loom-video/">Atlassian's Loom help</a> says users on the Starter plan can't download videos; downloading needs Business or higher. In Reelbird every take is already a folder of standard MP4 files on your Mac, and you can export MP4 (H.264), HEVC, ProRes or GIF.` },
  { id: "loom-price", q: "How much does Loom cost?", a: `As of ${CHECKED_LABEL}: Starter is free, Business is $18 and Business + AI is $24 per user a month billed monthly, and paying yearly saves up to 17%. Enterprise is priced on request. Reelbird is free, with no per-user price; optional Reelbird Pro is $5 a month if you want your links hosted.`, html: `As of ${CHECKED_LABEL}: Starter is free, Business is $18 and Business + AI is $24 per user a month billed monthly, and paying yearly saves up to 17% (<a href="https://www.loom.com/pricing">Loom pricing</a>). Enterprise is priced on request. Reelbird is free, with no per-user price; optional <a href="/pricing/">Reelbird Pro</a> is $5 a month if you want your links hosted.` },
  { id: "free-no-limit", q: "Is there a free Loom alternative without a 5-minute limit?", a: "Reelbird is one, for the Mac: free, MIT licensed, no length limit, and a share link on your clipboard when you stop. Other open-source options: Cap has instant links too, but its free plan is for personal use and caps share links at 5 minutes; OpenScreen is free and cross-platform but has no share links.", html: `Reelbird is one, for the Mac: free, MIT licensed, no length limit, and a share link on your clipboard when you stop. Other open-source options: Cap has instant links too, but its free plan is for personal use and caps share links at 5 minutes; OpenScreen is free and cross-platform but has no share links. See the <a href="/compare/">comparison</a>.` },
  { id: "loom-move", q: "Can I move my Loom videos to Reelbird?", a: "Not directly. Reelbird has no Loom importer. On a paid Loom plan you can download each video as an MP4 and keep it; Starter users can't download. New recordings in Reelbird stay on your Mac from the start." },
  { id: "where", q: "Where are my Reelbird videos stored?", a: "On your Mac, in ~/Movies/Reelbird, as standard MP4 files. A shared video is also copied to the bucket you set up, or to Reelbird Pro's storage if you use Pro, and nowhere else.", html: "On your Mac, in <code>~/Movies/Reelbird</code>, as standard MP4 files. A shared video is also copied to the bucket you set up, or to Reelbird Pro's storage if you use Pro, and nowhere else." },
  { id: "viewers", q: "Do viewers need an account or an app?", a: "No. The link opens a plain web page in any browser. Links are unlisted, not secret. Anyone with the link can watch." },
  { id: "server", q: "Do I have to run a server for links?", a: "No. Reelbird uploads a small viewer page and the video straight to an S3-compatible bucket you own. There's no database or server to run, and setup takes about ten minutes, once. If you'd rather skip that, Reelbird Pro hosts your links for $5 a month.", html: "No. Reelbird uploads a small viewer page and the video straight to an S3-compatible bucket you own. There's no database or server to run, and <a href=\"/docs/sharing/\">sharing setup</a> takes about ten minutes, once. If you'd rather skip that, <a href=\"/pricing/\">Reelbird Pro</a> hosts your links for $5 a month." },
  { id: "teams", q: "Is Reelbird good for teams?", a: "It works for anyone who can open a link, but it has no comments, reactions or shared workspace. Reelbird Pro shows views and where people stopped watching. If your team relies on comments and workspaces, Loom does more." },
];
